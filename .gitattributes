# Text files are stored with LF line endings in git, and eol=lf also checks
# them out with LF in every working tree. That overrides core.autocrlf, so
# Windows checkouts get LF rather than CRLF. Editors that handle LF need no
# change; to keep CRLF checkouts instead, this line would become
# "* text=auto".
* text=auto eol=lf

# Binary assets
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary

# The root index.html is stored with mixed line endings (CRLF with some LF
# lines). Normalising it would rewrite 2,129 of the 2,142 lines of the protected classroom
# file and hide real changes in the diff. Leave it as stored until a
# separate, reviewed PR normalises it on its own. The leading slash limits
# this exemption to the root file, not any index.html elsewhere.
/index.html -text
